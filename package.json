{
  "name": "react-native-deeplinkly",
  "version": "0.1.0",
  "description": "React Native SDK for deep linking, deferred deep linking, install referrer tracking, and attribution.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "react-native-deeplinkly.podspec",
    "docs/REACT_NATIVE_SDK.md",
    "docs/SIGNALS.md",
    "!**/__tests__",
    "!**/*.test.*",
    "!**/.*",
    "!android/build",
    "!android/.gradle",
    "!android/.cxx",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!android/src/test",
    "!android/src/androidTest",
    "!ios/build",
    "!ios/Pods",
    "!**/*.log",
    "!**/deeplinkly.properties"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{js,ts,tsx}\"",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "pack:audit": "node scripts/pack-audit.js",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "deep-linking",
    "deferred-deep-linking",
    "install-referrer",
    "attribution",
    "ios",
    "android"
  ],
  "repository": "https://github.com/deeplinkly/react-native-deeplinkly",
  "homepage": "https://deeplinkly.com",
  "bugs": {
    "url": "https://github.com/deeplinkly/react-native-deeplinkly/issues"
  },
  "author": "Deeplinkly <hello@deeplinkly.com>",
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.87.0",
    "@react-native/jest-preset": "^0.87.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.87.0",
    "react-native-builder-bob": "^0.40.0",
    "typescript": "^5.8.0"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "roots": [
      "<rootDir>/src"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/example",
      "<rootDir>/lib/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/__tests__/**"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNDeeplinklySpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.deeplinkly.reactnative"
    }
  }
}
